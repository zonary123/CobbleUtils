# GitHub Secrets
GITHUB_TOKEN=your_github_token
DEPLOY_KEY=your_deploy_key

# Modrinth
MODRINTH_ID=your_modrinth_id
MODRINTH_TOKEN=your_modrinth_token
MODRINTH_PROJECT=your_modrinth_project

# CurseForge
CURSEFORGE_ID=your_curseforge_id
CURSEFORGE_TOKEN=your_curseforge_token

# Discord
ANNOUNCEMENTS_WEBHOOK=your_discord_webhook_url

# Release Tags
PRERELEASE_TAG=your_prerelease_tag
RELEASE_TAG=your_release_tag

# Release Messages
PRERELEASE_BUILD_MESSAGE=your_prerelease_build_message
RELEASE_BUILD_MESSAGE=your_release_build_message
RELEASE_ANNOUNCEMENT_MESSAGE=your_release_announcement_message